local NORMAL_SPEED = 8
local FAST_SPEED = 10
local SLOW_SPEED = 5

local JUMP_FORCE = 375
local GRAVITY = -1100
local FALL_FAIL_Y = -50

local PICKUP_DISTANCE = 1
local HAZARD_DISTANCE = 0
local BELT_DISTANCE = 6
local DOOR_DISTANCE = 1
local DOOR_EXIT_OFFSET = 3

local PIPE_DISTANCE_X = 0
local PIPE_HIT_HEIGHT = 1

local CAMERA = "/Camera"
local CAMERA_OFFSET_X = 0

local chests = { "/chest", "/chest1" }
local hazards = { "/acid", "/acid1" }
local pipes = { "/pipe5", "/pipe7" }

local fast_belts = {
	"/conveyerBelts/Conveyor",
	"/conveyerBelts/Conveyor1",
	"/conveyerBelts/Conveyor2",
	"/conveyerBelts/Conveyor3"
}

local slow_belts = {
	"/conveyerBelts1/Conveyor4",
	"/conveyerBelts1/Conveyor5"
}

local level1_door = "/door"
local level2_door = "/finalDoor"

local function close_to(a, b, distance)
	return vmath.length(a - b) <= distance
end

local function safe_get_position(id)
	local ok, pos = pcall(go.get_position, id)
	if ok then
		return pos
	end
	return nil
end

local function hide_object(id)
	pcall(go.set_position, vmath.vector3(-9999, -9999, 0), id)
end

local function follow_camera_x(player_pos)
	local camera_pos = safe_get_position(CAMERA)
	if camera_pos then
		camera_pos.x = player_pos.x + CAMERA_OFFSET_X
		go.set_position(camera_pos, CAMERA)
	end
end

local function fail(self)
	if self.failed then
		return
	end

	self.failed = true
	print("FAIL")
	msg.post("/GUI#gui", "show_restart")
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.velocity_y = 0
	self.grounded = false
	self.score = 0
	self.failed = false
	self.level_complete = false
	self.started_level2 = false

	print("LEVEL 1 STARTED")
	print("Score: 0")
end

function update(self, dt)
	if self.failed or self.level_complete then
		return
	end

	self.grounded = false

	local pos = go.get_position()
	local speed = NORMAL_SPEED

	for _, id in ipairs(fast_belts) do
		local belt_pos = safe_get_position(id)
		if belt_pos and close_to(pos, belt_pos, BELT_DISTANCE) then
			speed = FAST_SPEED
		end
	end

	for _, id in ipairs(slow_belts) do
		local belt_pos = safe_get_position(id)
		if belt_pos and close_to(pos, belt_pos, BELT_DISTANCE) then
			speed = SLOW_SPEED
		end
	end

	pos.x = pos.x + speed * dt

	self.velocity_y = self.velocity_y + GRAVITY * dt
	pos.y = pos.y + self.velocity_y * dt

	go.set_position(pos)
	follow_camera_x(pos)

	if pos.y < FALL_FAIL_Y then
		fail(self)
		return
	end

	for _, id in ipairs(chests) do
		local chest_pos = safe_get_position(id)
		if chest_pos and chest_pos.y > -9000 and close_to(pos, chest_pos, PICKUP_DISTANCE) then
			self.score = self.score + 10
			print("Score: " .. self.score)
			msg.post("/GUI#gui", "set_score", { score = self.score })
			hide_object(id)
		end
	end

	for _, id in ipairs(hazards) do
		local hazard_pos = safe_get_position(id)
		if hazard_pos and close_to(pos, hazard_pos, HAZARD_DISTANCE) then
			fail(self)
			return
		end
	end

	for _, id in ipairs(pipes) do
		local pipe_pos = safe_get_position(id)
		if pipe_pos then
			local close_x = math.abs(pos.x - pipe_pos.x) <= PIPE_DISTANCE_X
			local too_low = pos.y <= pipe_pos.y + PIPE_HIT_HEIGHT

			if close_x and too_low then
				fail(self)
				return
			end
		end
	end

	local level1_door_pos = safe_get_position(level1_door)

	if not self.started_level2
	and level1_door_pos
	and close_to(pos, level1_door_pos, DOOR_DISTANCE) then
		print("LEVEL 1 COMPLETE")

		self.level_complete = true
		self.velocity_y = 0

		msg.post("/GUI#gui", "show_level_complete", { score = self.score })
		return
	end

	local level2_door_pos = safe_get_position(level2_door)

	if self.started_level2
	and level2_door_pos
	and math.abs(pos.x - level2_door_pos.x-25) <= DOOR_DISTANCE then
		print("VICTORY")

		self.level_complete = true
		self.velocity_y = 0

		msg.post("/GUI#gui", "show_victory", { score = self.score })
		return
	end
end

function on_input(self, action_id, action)
	if action.pressed and action_id == hash("jump") then
		if self.grounded then
			self.velocity_y = JUMP_FORCE
			self.grounded = false
		end
	end

	if action.pressed and action_id == hash("restart") then
		msg.post("@system:", "reboot")
	end
end

function on_message(self, message_id, message)
	if message_id == hash("contact_point_response") then
		if message.normal.y > 0.7 then
			local pos = go.get_position()
			pos = pos + message.normal * message.distance
			go.set_position(pos)

			self.grounded = true
			self.velocity_y = 0
		end

	elseif message_id == hash("start_level2") then
		print("LEVEL 2 STARTED")

		self.started_level2 = true
		self.level_complete = false
		self.failed = false
		self.grounded = false
		self.velocity_y = 0

		local pos = go.get_position()
		pos.x = pos.x + DOOR_EXIT_OFFSET
		go.set_position(pos)

		follow_camera_x(pos)
	end
end