local NORMAL_SPEED = 10
local FAST_SPEED = 20
local SLOW_SPEED = 6

local JUMP_FORCE = 600
local GRAVITY = -1600
local FALL_FAIL_Y = -300

local PICKUP_DISTANCE = 18
local HAZARD_DISTANCE = 1
local BELT_DISTANCE = 1
local DOOR_DISTANCE = 1

local chests = {
	"/chest"
}

local hazards = {
	"/acid"
}

local fast_belts = {
	"/Conveyor",
	"/Conveyor1",
	"/Conveyor2"
}

local slow_belts = {
}

local door = "/door1"

local function close_to(a, b, distance)
	return vmath.length(a - b) <= distance
end

local function safe_get_position(id)
	local ok, pos = pcall(go.get_position, id)
	if ok then
		return pos
	end
	return nil
end

local function hide_object(id)
	pcall(go.set_position, vmath.vector3(-9999, -9999, 0), id)
end

function init(self)
	msg.post(".", "acquire_input_focus")

	self.velocity_y = 0
	self.grounded = false
	self.score = 0
	self.failed = false
	self.level_complete = false

	local pos = go.get_position()
	pos.y = pos.y + 8
	go.set_position(pos)

	print("GAME STARTED")
	print("Score: 0")
end

function update(self, dt)
	if self.failed or self.level_complete then
		return
	end

	-- Important: assume falling unless collision proves we are on ground.
	self.grounded = false

	local pos = go.get_position()
	local speed = NORMAL_SPEED

	for _, id in ipairs(fast_belts) do
		local belt_pos = safe_get_position(id)
		if belt_pos and close_to(pos, belt_pos, BELT_DISTANCE) then
			speed = FAST_SPEED
		end
	end

	for _, id in ipairs(slow_belts) do
		local belt_pos = safe_get_position(id)
		if belt_pos and close_to(pos, belt_pos, BELT_DISTANCE) then
			speed = SLOW_SPEED
		end
	end

	pos.x = pos.x + speed * dt

	self.velocity_y = self.velocity_y + GRAVITY * dt
	pos.y = pos.y + self.velocity_y * dt

	go.set_position(pos)

	for _, id in ipairs(chests) do
		local chest_pos = safe_get_position(id)
		if chest_pos and chest_pos.y > -9000 and close_to(pos, chest_pos, PICKUP_DISTANCE) then
			self.score = self.score + 10
			print("Score: " .. self.score)
			hide_object(id)
		end
	end

	for _, id in ipairs(hazards) do
		local hazard_pos = safe_get_position(id)
		if hazard_pos and close_to(pos, hazard_pos, HAZARD_DISTANCE) then
			self.failed = true
			print("FAIL")
			print("Press R to Restart")
		end
	end

	local door_pos = safe_get_position(door)
	if door_pos and close_to(pos, door_pos, DOOR_DISTANCE) then
		self.level_complete = true
		print("LEVEL COMPLETE")
		print("FINAL SCORE: " .. self.score)
	end

	if pos.y < FALL_FAIL_Y then
		self.failed = true
		print("FAIL")
		print("Press R to Restart")
	end
end

function on_input(self, action_id, action)
	if action.pressed and action_id == hash("jump") then
		if self.grounded then
			self.velocity_y = JUMP_FORCE
			self.grounded = false
		end
	end

	if action.pressed and action_id == hash("restart") then
		msg.post("@system:", "reboot")
	end
end

function on_message(self, message_id, message)
	if message_id == hash("contact_point_response") then
		if message.normal and message.distance then
			if message.normal.y > 0.7 then
				local pos = go.get_position()
				pos.y = pos.y + message.normal.y * message.distance
				go.set_position(pos)

				self.grounded = true
				self.velocity_y = 0
			end
		end
	end
end